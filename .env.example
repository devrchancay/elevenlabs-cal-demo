# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. .env is in .gitignore.
# The static site has its own settings in web/.env.example.
# ---------------------------------------------------------------------------

# Railway injects PORT automatically. Leave it empty locally (defaults to 3000).
PORT=3000

# --- Cal.com ---------------------------------------------------------------
# Settings -> Developer -> API Keys. Starts with cal_live_ or cal_.
CAL_API_KEY=
# The NUMERIC event type id for the 30 minute event, not the slug.
CAL_EVENT_TYPE_ID=

# --- Business --------------------------------------------------------------
BUSINESS_TIMEZONE=America/Guayaquil
APPOINTMENT_DURATION_MINUTES=30

# --- Security --------------------------------------------------------------
# At least 16 characters. Generate one with: openssl rand -hex 32
# The same value goes into the ElevenLabs Secrets Manager.
TOOLS_SHARED_SECRET=
# Provided by ElevenLabs when you create the post-call webhook. Starts with wsec_.
ELEVENLABS_WEBHOOK_SECRET=

# --- Used only by the CLI and the scripts, never by the server --------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Public backend URL, needed by `pnpm agent:setup`.
PUBLIC_BASE_URL=

# --- Read only by docker compose, when building the web image --------------
# Vite inlines these at build time, so `docker compose up --build` has to rerun
# for a change to apply. The Vite dev server reads web/.env instead.
# VITE_BACKEND_URL is the address the BROWSER calls, so it cannot be the compose
# service name.
VITE_ELEVENLABS_AGENT_ID=
VITE_BACKEND_URL=http://localhost:3000

# --- Optional --------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_MAX=60
CONVERSATIONS_LOG_PATH=./data/conversations.json
