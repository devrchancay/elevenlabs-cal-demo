{
  "name": "elevenlabs-agent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "web:dev": "pnpm --filter elevenlabs-agent-web dev",
    "web:build": "pnpm --filter elevenlabs-agent-web build",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "smoke:slots": "tsx scripts/smoke-slots.ts",
    "smoke:book": "tsx scripts/smoke-book.ts",
    "simulate": "tsx scripts/simulate.ts",
    "agent:setup": "tsx scripts/agent-setup.ts setup",
    "agent:link": "tsx scripts/agent-setup.ts link"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.1",
    "eslint": "^9.19.0",
    "globals": "^17.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5"
  }
}
